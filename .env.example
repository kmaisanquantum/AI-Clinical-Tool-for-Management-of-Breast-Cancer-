# Copy to .env (never commit). Synthetic data only in dev.
# The app also boots with no env at all (SQLite + generated secret key), which is
# what makes a fresh Coolify deploy start cleanly instead of restart-looping.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
PORT=8000

# Startup behaviour (Dockerfile/entrypoint.sh)
RUN_MIGRATIONS=1        # default 1; set 0 to skip migrations on startup
SEED_DEMO_DATA=1        # set 1 to load demo users/data on startup (demo/synthetic-only)
DOCTOR_DEMO_PASSWORD=doctor  # default password for demo 'doctor' admin account (demo/synthetic-only)

# Prod behind a TLS-terminating proxy (Coolify/Traefik/Nginx). Set to 1 only if
# the app itself must redirect HTTP->HTTPS; the health probe is always exempt.
# DJANGO_SECURE_SSL_REDIRECT=1

# Deploy Option 1: Coolify / Prod (URL-based connection)
# DATABASE_URL=postgres://cdsp:password@host:5432/cdsp

# Deploy Option 2: docker-compose dev
POSTGRES_DB=cdsp
POSTGRES_USER=cdsp
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
